<Window x:Class="BalenceNoToolbox.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:BalenceNoToolbox"
        mc:Ignorable="d"
        Title="Balence's Toolbox" Height="450" Width="800">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="auto" />
        </Grid.RowDefinitions>

        <Border Padding="20" Grid.Row="0">
            <StackPanel Orientation="Vertical">
                <Label FontSize="32" FontWeight="Bold">Daily Tasks:</Label>
                <ItemsControl ItemsSource="{Binding AllTodos}" Padding="0, 20, 0, 0">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal">
                                <CheckBox IsChecked="{Binding IsDone}" />
                                <TextBlock Text="{Binding Title}" />
                            </StackPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </Border>
        
        <StackPanel Grid.Row="1" Orientation="Horizontal">
            <TextBox x:Name="NewTodoTextBox" Width="150" Margin="10"/>
            <Button Content="Add Todo" Click="AddTodoButton_Clicked" Margin="10"/>
        </StackPanel>
    </Grid>
</Window>